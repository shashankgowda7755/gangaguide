{
  "name": "gangaguides",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --import tsx --watch server/index.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir ../dist/server && node --import tsx scripts/prerender.ts",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "preview": "npm run build && npm start",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "images": "node scripts/optimize-images.mjs",
    "qa": "node scripts/qa.mjs",
    "og": "node --import tsx scripts/og-cards.ts"
  },
  "dependencies": {
    "@fontsource/mukta": "^5.2.5",
    "@fontsource/young-serif": "^5.2.5",
    "@neondatabase/serverless": "^1.0.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "wouter": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "sharp": "^0.34.3",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
